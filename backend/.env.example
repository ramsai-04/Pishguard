NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:ram@localhost:4335/phishguard?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
PHISHING_THRESHOLD=0.62
PHISHING_BLOCKLIST_THRESHOLD=0.95
PHISHING_BLOCKLIST_MIN_DETECTIONS=2
TRUSTED_DOMAINS=google.com,facebook.com,github.com,microsoft.com,apple.com,usa.gov
PHISHING_DATASET_PATH=src/ml/training/phishing.csv
PHISHING_HARD_NEGATIVE_PATH=src/ml/training/hard_negatives.txt
PHISHING_MODEL_PATH=src/ml/models/xgboost-model.json
PHISHING_MODEL_META_PATH=src/ml/models/xgboost-meta.json
PHISHING_LABEL_VALUE=0
PHISHING_TRAIN_MAX_ROWS=0
PYTHON_BIN=python
REPUTATION_TIMEOUT_MS=3000
REPUTATION_CACHE_TTL_MS=3600000
REPUTATION_ENABLE_EXTERNAL=true
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
PHISHTANK_ENDPOINT=https://checkurl.phishtank.com/checkurl/
RDAP_LOOKUP_BASE_URL=https://rdap.org/domain/
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SCAN_MAX=60
PHISHING_BLOCKLIST_TTL_HOURS=168
